# Copy to .env and fill in. Never commit .env.
ENV=dev

# Postgres (local: brew postgresql@16 + scripts/db/init.sql; see docs/local-setup.md)
# App role: DML only, subject to row-level security. API and workers use this.
DATABASE_URL=postgresql+psycopg://vp_app:vp_app_local_dev@localhost:5432/vp_dev
# Owner role: DDL. Alembic only.
MIGRATION_DATABASE_URL=postgresql+psycopg://vp_migrator:vp_migrator_local_dev@localhost:5432/vp_dev
# Separate database for tests (tenant-isolation tests run as vp_app against this)
TEST_DATABASE_URL=postgresql+psycopg://vp_app:vp_app_local_dev@localhost:5432/vp_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://vp_migrator:vp_migrator_local_dev@localhost:5432/vp_test

# Redis (local: brew redis)
REDIS_URL=redis://localhost:6379/0

# Provider keys (platform defaults; tenants may BYOK, stored encrypted in DB)
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Telephony
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Dashboard (dashboard/.env.local): base URL of the API, used server-side for config validation
API_URL=http://localhost:8000
