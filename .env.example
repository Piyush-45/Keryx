# Copy to .env and fill in. Never commit .env.
ENV=dev
DATABASE_URL=postgresql+psycopg://vp:vp_local_dev@localhost:5432/vp
REDIS_URL=redis://localhost:6379/0

# Provider keys (platform defaults; tenants may BYOK, stored encrypted in DB)
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Telephony
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
